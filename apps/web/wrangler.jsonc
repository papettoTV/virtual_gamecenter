{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "virtual-gamecenter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-26",
  "vars": {
    "APP_ENV": "local",
    "DEVELOPER_AUTH_ENABLED": "true",
    "CREDIT_PURCHASES_ENABLED": "false"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CABINET_ROOMS",
        "class_name": "CabinetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CabinetRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graze-duel-rankings",
      "database_id": "c0050cdb-dc20-42fb-9855-bfb155ba5dd2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["0 * * * *"] },
  "r2_buckets": [{ "binding": "DELETION_AUDIT", "bucket_name": "pulbase-deletion-audit" }],
  "env": {
    "staging": {
      "name": "pulbase-staging",
      "workers_dev": false,
      "vars": {
        "APP_ENV": "staging",
        "DEVELOPER_AUTH_ENABLED": "false",
        "CREDIT_PURCHASES_ENABLED": "false"
      },
      "secrets": { "required": ["BASIC_AUTH_USERNAME", "BASIC_AUTH_PASSWORD", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"] },
      "durable_objects": { "bindings": [{ "name": "CABINET_ROOMS", "class_name": "CabinetRoom" }] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pulbase-staging",
        "database_id": "00000000-0000-0000-0000-000000000001",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "DELETION_AUDIT", "bucket_name": "pulbase-staging-deletion-audit" }],
      "triggers": { "crons": ["0 * * * *"] }
    },
    "production": {
      "name": "pulbase-production",
      "workers_dev": false,
      "vars": {
        "APP_ENV": "production",
        "DEVELOPER_AUTH_ENABLED": "false",
        "CREDIT_PURCHASES_ENABLED": "false"
      },
      "secrets": { "required": ["BASIC_AUTH_USERNAME", "BASIC_AUTH_PASSWORD", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"] },
      "durable_objects": { "bindings": [{ "name": "CABINET_ROOMS", "class_name": "CabinetRoom" }] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pulbase-production",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "DELETION_AUDIT", "bucket_name": "pulbase-production-deletion-audit" }],
      "triggers": { "crons": ["0 * * * *"] }
    }
  }
}
