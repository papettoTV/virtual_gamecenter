{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "virtual-gamecenter",
  "account_id": "60e5472a284dc71bbafbbfac8aa2a940",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-26",
  "vars": {
    "APP_ENV": "local",
    "USAGE_MONITOR_ENABLED": "false",
    "METRICS_ACCOUNT_ID": "60e5472a284dc71bbafbbfac8aa2a940",
    "DEVELOPER_AUTH_ENABLED": "true",
    "CREDIT_PURCHASES_ENABLED": "false"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CABINET_ROOMS",
        "class_name": "CabinetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CabinetRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graze-duel-rankings",
      "database_id": "c0050cdb-dc20-42fb-9855-bfb155ba5dd2",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [{"name":"API_READ_LIMITER","namespace_id":"2026101401","simple":{"limit":600,"period":60}},{"name":"API_WRITE_LIMITER","namespace_id":"2026101402","simple":{"limit":120,"period":60}},{"name":"BOOTSTRAP_LIMITER","namespace_id":"2026101403","simple":{"limit":60,"period":60}},{"name":"BENEFIT_LIMITER","namespace_id":"2026101404","simple":{"limit":10,"period":60}},{"name":"SOCKET_LIMITER","namespace_id":"2026101405","simple":{"limit":60,"period":60}},{"name":"AUTH_LIMITER","namespace_id":"2026101406","simple":{"limit":20,"period":60}}],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["0 * * * *"] },
  "r2_buckets": [{ "binding": "DELETION_AUDIT", "bucket_name": "pulbase-deletion-audit" }],
  "env": {
    "staging": {
      "name": "pulbase-staging",
      "ratelimits": [{"name":"API_READ_LIMITER","namespace_id":"2026101411","simple":{"limit":600,"period":60}},{"name":"API_WRITE_LIMITER","namespace_id":"2026101412","simple":{"limit":120,"period":60}},{"name":"BOOTSTRAP_LIMITER","namespace_id":"2026101413","simple":{"limit":60,"period":60}},{"name":"BENEFIT_LIMITER","namespace_id":"2026101414","simple":{"limit":10,"period":60}},{"name":"SOCKET_LIMITER","namespace_id":"2026101415","simple":{"limit":60,"period":60}},{"name":"AUTH_LIMITER","namespace_id":"2026101416","simple":{"limit":20,"period":60}}],
      "workers_dev": false,
      "vars": {
        "APP_ENV": "staging",
        "USAGE_MONITOR_ENABLED": "true",
        "METRICS_ACCOUNT_ID": "60e5472a284dc71bbafbbfac8aa2a940",
        "DEVELOPER_AUTH_ENABLED": "false",
        "CREDIT_PURCHASES_ENABLED": "false"
      },
      "secrets": { "required": ["BASIC_AUTH_USERNAME", "BASIC_AUTH_PASSWORD", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "CLOUDFLARE_METRICS_TOKEN"] },
      "analytics_engine_datasets": [{ "binding": "USAGE_METRICS", "dataset": "pulbase_account_usage" }],
      "durable_objects": { "bindings": [{ "name": "CABINET_ROOMS", "class_name": "CabinetRoom" }] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pulbase-staging",
        "database_id": "c49b03c7-e616-4acb-96a8-2837ff62034f",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "DELETION_AUDIT", "bucket_name": "pulbase-staging-deletion-audit" }],
      "triggers": { "crons": ["0 * * * *", "0,15,30,45 * * * *"] }
    },
    "production": {
      "name": "pulbase-production",
      "ratelimits": [{"name":"API_READ_LIMITER","namespace_id":"2026101421","simple":{"limit":600,"period":60}},{"name":"API_WRITE_LIMITER","namespace_id":"2026101422","simple":{"limit":120,"period":60}},{"name":"BOOTSTRAP_LIMITER","namespace_id":"2026101423","simple":{"limit":60,"period":60}},{"name":"BENEFIT_LIMITER","namespace_id":"2026101424","simple":{"limit":10,"period":60}},{"name":"SOCKET_LIMITER","namespace_id":"2026101425","simple":{"limit":60,"period":60}},{"name":"AUTH_LIMITER","namespace_id":"2026101426","simple":{"limit":20,"period":60}}],
      "workers_dev": false,
      "vars": {
        "APP_ENV": "production",
        "USAGE_MONITOR_ENABLED": "false",
        "METRICS_ACCOUNT_ID": "60e5472a284dc71bbafbbfac8aa2a940",
        "DEVELOPER_AUTH_ENABLED": "false",
        "CREDIT_PURCHASES_ENABLED": "false"
      },
      "secrets": { "required": ["BASIC_AUTH_USERNAME", "BASIC_AUTH_PASSWORD", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"] },
      "durable_objects": { "bindings": [{ "name": "CABINET_ROOMS", "class_name": "CabinetRoom" }] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pulbase-production",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "DELETION_AUDIT", "bucket_name": "pulbase-production-deletion-audit" }],
      "triggers": { "crons": ["0 * * * *"] }
    }
  }
}
