{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulbase-service-monitor",
  "account_id": "60e5472a284dc71bbafbbfac8aa2a940",
  "main": "src/monitor/worker.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "HEALTH_STATE", "id": "ab926be25f7740a08844889f0c5e0b3f" }],
  "analytics_engine_datasets": [{ "binding": "HEALTH_EVENTS", "dataset": "pulbase_service_health" }],
  "secrets": { "required": ["PULBASE_CHECK_USERNAME", "PULBASE_CHECK_PASSWORD"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
