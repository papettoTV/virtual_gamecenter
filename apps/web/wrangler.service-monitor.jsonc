{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulbase-service-monitor",
  "account_id": "60e5472a284dc71bbafbbfac8aa2a940",
  "main": "src/monitor/main.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "MONITOR_ENVIRONMENT": "staging", "START_SLO_ENABLED": "true" },
  "d1_databases": [{ "binding": "START_SLO_DB", "database_name": "pulbase-staging", "database_id": "c49b03c7-e616-4acb-96a8-2837ff62034f" }],
  "services": [{ "binding": "HEALTH_DRILL_PROBE", "service": "pulbase-service-monitor", "entrypoint": "HealthDrillProbe" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "HEALTH_STATE", "id": "ab926be25f7740a08844889f0c5e0b3f" }],
  "analytics_engine_datasets": [{ "binding": "HEALTH_EVENTS", "dataset": "pulbase_service_health" }],
  "secrets": { "required": ["PULBASE_CHECK_USERNAME", "PULBASE_CHECK_PASSWORD"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
