{
  "name": "@pulbase/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "npm run db:migrate:local",
    "dev": "vite",
    "prestart": "npm run db:migrate:local",
    "start": "vite",
    "generate-types": "wrangler types",
    "typecheck": "npm run generate-types && tsc --noEmit",
    "test": "vitest run && npm run test:recovery && npm run test:analytics && npm run test:release && npm run test:monitor && npm run test:service-check",
    "test:recovery": "vitest run --config vitest.recovery.config.ts",
    "test:analytics": "node --test tests/analytics-runtime.test.mjs",
    "test:release": "node --test tests/release-config.test.mjs tests/pages-targets.test.mjs",
    "test:monitor": "node --test tests/usage-monitor-verification.test.mjs",
    "test:service-check": "node --experimental-strip-types --test tests/service-check.test.mjs tests/service-monitor.test.mjs tests/recovery-drill.test.mjs tests/do-recovery-drill.test.mjs",
    "recovery:do-drill": "node scripts/do-recovery-drill.mjs",
    "recovery:drill": "node scripts/recovery-drill.mjs",
    "service:check": "node --experimental-strip-types scripts/service-check.mjs",
    "test:load": "node scripts/beta-load.mjs",
    "monitor:verify": "node scripts/verify-usage-monitor.mjs",
    "pages:target:check": "node scripts/pages-targets.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "build": "npm run typecheck && vite build && npm run build:pages",
    "preview": "vite preview --host 0.0.0.0",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/release.mjs migrate",
    "release:check": "node scripts/release.mjs check",
    "build:staging": "node scripts/release.mjs build staging",
    "build:production": "node scripts/release.mjs build production",
    "stripe:check": "./scripts/check-stripe-test-config.sh",
    "stripe:listen": "./scripts/stripe-listen.sh",
    "deploy": "node scripts/release.mjs deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.185.1",
    "vite": "8.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0",
    "ws": "8.21.0"
  }
}
