{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "virtual-gamecenter",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CABINET_ROOMS",
        "class_name": "CabinetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CabinetRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graze-duel-rankings",
      "database_id": "c0050cdb-dc20-42fb-9855-bfb155ba5dd2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
