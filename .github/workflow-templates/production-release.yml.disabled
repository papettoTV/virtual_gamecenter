# INACTIVE TEMPLATE. Do not move into workflows until separately authorized.
name: Production release (human approved)
on:
  workflow_dispatch:
    inputs:
      release_sha:
        description: Full tested develop SHA (must be a fast-forward of main)
        required: true
        type: string
      announcement:
        description: Approved X message, maximum 140 Unicode characters
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: pulbase-production-release
  cancel-in-progress: false
jobs:
  prepare:
    if: github.ref == 'refs/heads/main' && vars.PULBASE_PRODUCTION_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 25
    environment: staging
    outputs:
      sha: ${{ steps.identity.outputs.sha }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
      - name: Validate fixed release and text before checking out candidate
        id: identity
        env:
          RELEASE_SHA: ${{ inputs.release_sha }}
          ANNOUNCEMENT: ${{ inputs.announcement }}
        run: |
          node --input-type=module -e 'import { assertSha } from "./ci/policy.mjs"; import { announcementText } from "./ci/announce-x.mjs"; assertSha(process.env.RELEASE_SHA); announcementText(process.env.ANNOUNCEMENT)'
          git merge-base --is-ancestor HEAD "$RELEASE_SHA"
          git merge-base --is-ancestor "$RELEASE_SHA" origin/develop
          git checkout --detach "$RELEASE_SHA"
          echo "sha=$RELEASE_SHA" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm ci
        working-directory: apps/web
      - name: Verify release locally, never deploy in prepare
        working-directory: apps/web
        run: |
          printf '%s\n' 'GOOGLE_CLIENT_ID=ci-example.apps.googleusercontent.com' 'GOOGLE_CLIENT_SECRET=ci-example' 'STRIPE_SECRET_KEY=sk_test_ci_example' 'STRIPE_WEBHOOK_SECRET=whsec_ci_example' > .dev.vars
          npm test
          npm run build:production
      - name: Verify this exact develop revision is deployed on staging
        env:
          PULBASE_CHECK_USERNAME: ${{ secrets.PULBASE_CHECK_USERNAME }}
          PULBASE_CHECK_PASSWORD: ${{ secrets.PULBASE_CHECK_PASSWORD }}
          PULBASE_EXPECTED_SHA: ${{ inputs.release_sha }}
        run: node ci/check-revision.mjs staging
      - name: Present approval evidence
        env:
          RELEASE_SHA: ${{ inputs.release_sha }}
          ANNOUNCEMENT: ${{ inputs.announcement }}
        run: |
          node -e 'require("fs").appendFileSync(process.env.GITHUB_STEP_SUMMARY, `Release SHA: ${process.env.RELEASE_SHA}\n\nX announcement:\n\n${process.env.ANNOUNCEMENT}\n\nCheck staging evidence and production-launch-checklist.md before approval.\n`)'
  release:
    needs: prepare
    runs-on: ubuntu-latest
    timeout-minutes: 30
    # Configure required human reviewer BEFORE enabling this workflow.
    environment: production
    steps:
      - uses: actions/create-github-app-token@v1
        id: app
        with:
          app-id: ${{ vars.PULBASE_RELEASE_APP_ID }}
          private-key: ${{ secrets.PULBASE_RELEASE_APP_PRIVATE_KEY }}
      - uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0
          token: ${{ steps.app.outputs.token }}
      - name: Promote exactly the human-approved commit (fast-forward only)
        env:
          RELEASE_SHA: ${{ needs.prepare.outputs.sha }}
          PULBASE_PRODUCTION_ENABLED: ${{ vars.PULBASE_PRODUCTION_ENABLED }}
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
        run: |
          node --input-type=module -e 'import { assertProductionApproval } from "./ci/policy.mjs"; assertProductionApproval({ ref: process.env.GITHUB_REF, enabled: process.env.PULBASE_PRODUCTION_ENABLED, sha: process.env.RELEASE_SHA })'
          node ci/check-pages.mjs production
          git merge-base --is-ancestor HEAD "$RELEASE_SHA"
          git checkout -B main "$RELEASE_SHA"
          git push origin "$RELEASE_SHA:refs/heads/main"
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm ci
        working-directory: apps/web
      - run: npm ci
        working-directory: ci
      - run: npx playwright install --with-deps chromium
        working-directory: ci
      - name: Build stamped production artifact without deployment credentials
        working-directory: apps/web
        env:
          PULBASE_RELEASE_SHA: ${{ needs.prepare.outputs.sha }}
        run: npm run build:production
      - name: Deploy production Worker and Pages
        working-directory: apps/web
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          PULBASE_RELEASE_SHA: ${{ needs.prepare.outputs.sha }}
        run: |
          node ../../ci/deploy-built.mjs production
      - name: Production regression (no credits consumed)
        env:
          PULBASE_CHECK_USERNAME: ${{ secrets.PULBASE_CHECK_USERNAME }}
          PULBASE_CHECK_PASSWORD: ${{ secrets.PULBASE_CHECK_PASSWORD }}
          PULBASE_EXPECTED_SHA: ${{ needs.prepare.outputs.sha }}
          PULBASE_BROWSER_ENVIRONMENT: production
          PULBASE_CONFIRM_PRODUCTION: 'true'
        run: |
          mkdir -p ci/results
          cd apps/web
          node --experimental-strip-types scripts/service-check.mjs --environment production --confirm-production > ../../ci/results/production-service.json
          cd ../..
          node ci/check-revision.mjs production --confirm-production
          cd ci
          npm run browser
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: production-evidence-${{ needs.prepare.outputs.sha }}
          path: |
            ci/results
            ci/test-results
            ci/playwright-report
          retention-days: 14
  announce:
    needs: [prepare, release]
    if: vars.PULBASE_X_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    environment: announcement
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ needs.prepare.outputs.sha }}
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - uses: actions/create-github-app-token@v1
        id: app
        with:
          app-id: ${{ vars.PULBASE_RELEASE_APP_ID }}
          private-key: ${{ secrets.PULBASE_RELEASE_APP_PRIVATE_KEY }}
      - name: Publish to X once, after regression success
        env:
          GH_TOKEN: ${{ steps.app.outputs.token }}
          PULBASE_RELEASE_SHA: ${{ needs.prepare.outputs.sha }}
          PULBASE_ANNOUNCEMENT: ${{ inputs.announcement }}
          PULBASE_PRODUCTION_REGRESSION_PASSED: 'true'
          X_API_KEY: ${{ secrets.X_API_KEY }}
          X_API_SECRET: ${{ secrets.X_API_SECRET }}
          X_ACCESS_TOKEN: ${{ secrets.X_ACCESS_TOKEN }}
          X_ACCESS_TOKEN_SECRET: ${{ secrets.X_ACCESS_TOKEN_SECRET }}
        run: node ci/announce-x.mjs
  failure:
    needs: [prepare, release, announce]
    if: always() && contains(needs.*.result, 'failure')
    runs-on: ubuntu-latest
    timeout-minutes: 3
    permissions:
      issues: write
    steps:
      - name: Record release or announcement failure for the operator
        uses: actions/github-script@v7
        env:
          RELEASE_SHA: ${{ needs.prepare.outputs.sha }}
          JOB_RESULTS: ${{ toJSON(needs) }}
        with:
          script: |
            const jobs = JSON.parse(process.env.JOB_RESULTS);
            const announcementOnly = jobs.release.result === 'success';
            await github.rest.issues.create({ ...context.repo,
              title: announcementOnly ? 'X release announcement needs attention' : 'Production release needs attention',
              body: `SHA: ${process.env.RELEASE_SHA || 'prepare failed'}\n\n${announcementOnly ? '本番確認は成功。X投稿状態を照合し、告知ジョブだけ再実行してください。' : '公開/回帰確認が未完了。部分公開の有無を確認し、復旧を判断してください。X告知は実行していません。'}\n\nEvidence: ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}` });
