name: developマージ後の検証を自動起動
on:
  workflow_run:
    workflows: [Web checks]
    types: [completed]
    branches: [develop]
permissions:
  contents: read
  actions: write
jobs:
  dispatch:
    if: >-
      vars.PULBASE_CONTROL_EVIDENCE_ENABLED == 'true' &&
      github.event.workflow_run.event == 'push' &&
      github.event.workflow_run.head_branch == 'develop' &&
      github.event.workflow_run.head_repository.full_name == github.repository &&
      github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-24.04
    timeout-minutes: 3
    steps:
      - name: 保護されたci-controlでマージ後の検証を起動
        env:
          GH_TOKEN: ${{ github.token }}
          CI_RUN_ID: ${{ github.event.workflow_run.id }}
          SOURCE_ATTEMPT: ${{ github.event.workflow_run.run_attempt }}
          THIS_ATTEMPT: ${{ github.run_attempt }}
          EXPECTED_CONTROL_SHA: ${{ vars.PULBASE_CONTROL_EVIDENCE_SHA }}
        run: |
          node --input-type=module <<'JS'
          const id=process.env.CI_RUN_ID;
          if(!/^[1-9][0-9]*$/.test(id)||process.env.SOURCE_ATTEMPT!=='1'||process.env.THIS_ATTEMPT!=='1'||!/^[a-f0-9]{40}$/.test(process.env.EXPECTED_CONTROL_SHA))throw Error('初回runと固定制御SHAが必要です');
          const base='https://api.github.com/repos/papettoTV/virtual_gamecenter/';
          const headers={Authorization:`Bearer ${process.env.GH_TOKEN}`,Accept:'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'};
          const ref=await fetch(base+'git/ref/heads/ci-control',{headers,redirect:'error',signal:AbortSignal.timeout(15000)});
          if(!ref.ok||(await ref.json()).object?.sha!==process.env.EXPECTED_CONTROL_SHA)throw Error('制御SHA不一致');
          const r=await fetch(base+'actions/workflows/postmerge-staging.yml/dispatches',{method:'POST',headers:{...headers,'Content-Type':'application/json'},redirect:'error',signal:AbortSignal.timeout(15000),body:JSON.stringify({ref:'ci-control',inputs:{ci_run_id:id}})});
          if(r.status!==204)throw Error('起動できません。自動再試行はしません');
          console.log('developの同一SHAの検証を起動しました。staging承認を待ちます。');
          JS
