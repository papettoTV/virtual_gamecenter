{
  "account_id": "60e5472a284dc71bbafbbfac8aa2a940",
  "name": "pulbase-production",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CabinetRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AbuseGuard"
      ]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "USAGE_MONITOR_ENABLED": "false",
    "METRICS_ACCOUNT_ID": "60e5472a284dc71bbafbbfac8aa2a940",
    "DEVELOPER_AUTH_ENABLED": "false",
    "CREDIT_PURCHASES_ENABLED": "false",
    "PUBLIC_BETA_ENABLED": "true"
  },
  "secrets": {
    "required": [
      "BASIC_AUTH_USERNAME",
      "BASIC_AUTH_PASSWORD",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CABINET_ROOMS",
        "class_name": "CabinetRoom"
      },
      {
        "name": "ABUSE_GUARDS",
        "class_name": "AbuseGuard"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulbase-production",
      "database_id": "af463342-06e5-4904-97fc-6569d59ceec3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DELETION_AUDIT",
      "bucket_name": "pulbase-production-deletion-audit"
    }
  ],
  "ratelimits": [
    {
      "name": "API_READ_LIMITER",
      "namespace_id": "2026101421",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "API_WRITE_LIMITER",
      "namespace_id": "2026101422",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "BOOTSTRAP_LIMITER",
      "namespace_id": "2026101423",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "BENEFIT_LIMITER",
      "namespace_id": "2026101424",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SOCKET_LIMITER",
      "namespace_id": "2026101425",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2026101426",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [],
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": true,
  "routes": []
}
